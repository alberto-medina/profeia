# Copiar este archivo a .env y completar con los valores reales.
# NUNCA subir el archivo .env real a git.

# Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_STORAGE_BUCKET=recursos-clases

# Proveedor de IA para contenido pedagogico (GPT)
IA_CONTENIDO_API_KEY=TU_API_KEY
IA_CONTENIDO_MODELO=gpt-4o-mini

# Proveedor de TTS (voz)
IA_VOZ_API_KEY=TU_API_KEY
IA_VOZ_PROVEEDOR=openai
IA_VOZ_MODELO=gpt-4o-mini-tts

# Voz clonada (requiere consentimiento explicito del docente)
IA_VOZ_CLONADA_API_KEY=
IA_VOZ_CLONADA_VOICE_ID=

# Proveedor de generacion de imagenes
IA_IMAGENES_API_KEY=TU_API_KEY
IA_IMAGENES_MODELO=gpt-image-1

# Proveedor de generacion de video (opcional, MVP 1.0 puede dejarlo vacio)
IA_VIDEO_API_KEY=

# Mercado Pago - suscripciones
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BACK_URL=http://127.0.0.1:8000/pagos/mercadopago/retorno

# Configuracion general
ENTORNO=desarrollo
PUERTO=8000
