<PantallaAlumno>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(10)

        EtiquetaSeccion:
            text: "Clase del alumno"

        BoxLayout:
            id: barra_codigo
            orientation: "horizontal"
            spacing: dp(8)
            size_hint_y: None
            height: dp(48)

            MDTextField:
                id: campo_codigo
                hint_text: "Codigo de clase"

            MDRectangleFlatButton:
                text: "BUSCAR"
                on_release: root.al_presionar_buscar_codigo()

        MDSpinner:
            id: indicador_carga
            size_hint: None, None
            size: dp(36), dp(36)
            pos_hint: {"center_x": 0.5}
            active: False

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                spacing: dp(12)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    id: etiqueta_titulo
                    font_style: "H5"
                    bold: True
