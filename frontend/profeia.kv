<PantallaRecursos>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        BarraSuperior:
            title: "Elegir recursos"
            accion_volver: root.al_presionar_atras

        EtiquetaSeccion:
            text: "Que recursos queres usar?"

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height

                TarjetaSeccion:
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        MDCheckbox:
                            id: check_voz
                            active: True
                            size_hint_x: None
                            width: dp(48)
                        MDLabel:
                            text: "Voz"

                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        MDCheckbox:
                            id: check_slides
                            active: True
                            size_hint_x: None
                            width: dp(48)
                        MDLabel:
                            text: "Slides"

                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        MDCheckbox:
                            id: check_imagenes
                            active: True
                            size_hint_x: None
                            width: dp(48)
                        MDLabel:
                            text: "Imagenes IA / locales"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(46)

                        MDRectangleFlatButton:
                            text: "BUSCAR IMAGENES GRATIS"
                            on_release: root.al_presionar_buscar_imagenes_web()

                        MDFlatButton:
                            text: "GENERAR OPCIONES CON IA"
                            on_release: root.al_presionar_generar_opciones_imagenes()

                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        MDCheckbox:
                            id: check_video
                            active: False
                            disabled: True
                            size_hint_x: None
                            width: dp(48)
                        MDLabel:
                            text: "Video (proximamente)"

                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        MDCheckbox:
                            id: check_pdf
                            active: True
                            size_hint_x: None
                            width: dp(48)
                        MDLabel:
                            text: "PDF"

                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        MDCheckbox:
                            id: check_pptx
                            active: True
                            size_hint_x: None
                            width: dp(48)
                        MDLabel:
                            text: "PowerPoint"

                TarjetaSeccion:
                    MDLabel:
                        text: "Recursos propios"
                        bold: True
                        size_hint_y: None
                        height: dp(24)
                        theme_text_color: "Custom"
                        text_color: app.color_texto_secundario

                    MDLabel:
                        text: "Adjunta imagenes o audios que quieras mostrar en la vista alumno y en el ZIP."
                        size_hint_y: None
                        height: dp(52)
                        text_size: self.width, None
                        theme_text_color: "Secondary"

                    MDTextField:
                        id: campo_imagen_docente
                        hint_text: "Ruta de imagen del docente"
                        mode: "rectangle"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(46)

                        MDFlatButton:
                            text: "ELEGIR IMAGEN"
                            on_release: root.al_presionar_buscar_imagen()

                        MDRectangleFlatButton:
                            text: "ADJUNTAR"
                            on_release: root.al_presionar_adjuntar_imagen()

                    MDTextField:
                        id: campo_audio_docente
                        hint_text: "Ruta de audio del docente"
                        mode: "rectangle"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(46)

                        MDFlatButton:
                            text: "ELEGIR AUDIO"
                            on_release: root.al_presionar_buscar_audio()

                        MDRectangleFlatButton:
                            text: "ADJUNTAR"
                            on_release: root.al_presionar_adjuntar_audio()

                MDLabel:
                    id: etiqueta_estado
                    size_hint_y: None
                    height: dp(42)
                    halign: "center"
                    text_size: self.width, None

                MDRectangleFlatButton:
                    id: boton_continuar
                    text: "CONTINUAR"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.al_presionar_continuar()

                MDSpinner:
                    id: indicador_carga
                    size_hint: None, None
                    size: dp(36), dp(36)
                    pos_hint: {"center_x": 0.5}
                    active: False


<PantallaVoz>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        BarraSuperior:
            title: "Elegir voz"
            accion_volver: root.al_presionar_atras

        EtiquetaSeccion:
            text: "Elegir voz"

        TarjetaSeccion:
            MDBoxLayout:
                id: grupo_voz
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: dp(180)
                selected: opcion_femenina

                MDChip:
                    id: opcion_clonada
                    text: "Clonar mi voz"
                    valor_interno: "clonada"
                    on_release: grupo_voz.selected = self
                    MDChipText:
                        text: "Clonar mi voz"

                MDChip:
                    id: opcion_masculina
                    text: "Voz masculina"
                    valor_interno: "masculina"
                    on_release: grupo_voz.selected = self
                    MDChipText:
                        text: "Voz masculina"

                MDChip:
                    id: opcion_femenina
                    text: "Voz femenina"
                    valor_interno: "femenina"
                    on_release: grupo_voz.selected = self
                    MDChipText:
                        text: "Voz femenina"

                MDChip:
                    id: opcion_infantil
                    text: "Voz infantil"
                    valor_interno: "infantil"
                    on_release: grupo_voz.selected = self
                    MDChipText:
                        text: "Voz infantil"

            MDLabel:
                text: "Idioma: Espanol"
                size_hint_y: None
                height: dp(30)

            MDLabel:
                text: "Velocidad"
                size_hint_y: None
                height: dp(24)

            MDSlider:
                id: slider_velocidad
                min: 0.5
                max: 1.5
                value: 0.9
                step: 0.05

        MDLabel:
            id: etiqueta_error
            theme_text_color: "Error"
            size_hint_y: None
            height: dp(24)

        Widget:

        MDRectangleFlatButton:
            id: boton_generar_voz
            text: "GENERAR VOZ"
            pos_hint: {"center_x": 0.5}
            on_release: root.al_presionar_generar_voz()

        MDSpinner:
            id: indicador_carga
            size_hint: None, None
            size: dp(36), dp(36)
            pos_hint: {"center_x": 0.5}
            active: False


