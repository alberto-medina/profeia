                    text_size: self.width, None
                    theme_text_color: "Secondary"

                MDRectangleFlatButton:
                    id: boton_exportar_zip
                    text: "EXPORTAR PAQUETE ZIP"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.al_presionar_exportar_zip()

                MDLabel:
                    id: etiqueta_estado_zip
                    size_hint_y: None
                    height: dp(38)
                    halign: "center"
                    valign: "middle"
                    text_size: self.width, None
                    theme_text_color: "Secondary"

                MDLabel:
                    text: "Publicacion directa a TikTok / YouTube / Instagram / WhatsApp disponible en la proxima version."
                    size_hint_y: None
                    height: dp(72)
                    text_size: self.width, None
                    theme_text_color: "Secondary"

                MDFlatButton:
                    text: "CREAR OTRA CLASE"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.al_presionar_nueva_clase()

                MDFlatButton:
                    text: "VER HISTORIAL"
                    pos_hint: {"center_x": 0.5}
                    on_release: app.root.current = "historial"
