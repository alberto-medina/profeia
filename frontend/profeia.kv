                    font_style: "Subtitle1"
                MDCard:
                    orientation: "vertical"
                    padding: dp(12)
                    size_hint_y: None
                    height: etiqueta_introduccion.texture_size[1] + dp(28)
                    radius: [dp(8)]
                    elevation: 1
                    md_bg_color: app.color_superficie

                    MDLabel:
                        id: etiqueta_introduccion
                        size_hint_y: None
                        height: self.texture_size[1] + dp(4)
                        text_size: self.width, None
                        theme_text_color: "Custom"
