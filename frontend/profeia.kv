#:kivy 2.2.1

<Screen>:
    canvas.before:
        Color:
            rgba: app.color_fondo
        Rectangle:
            pos: self.pos
            size: self.size

<EtiquetaSeccion@MDLabel>:
    font_style: "H6"
    bold: True
    theme_text_color: "Custom"
    text_color: app.color_texto
    size_hint_y: None
    height: self.texture_size[1] + dp(10)
    halign: "left"
    text_size: self.width, None

<MDTextField>:
    write_tab: False

<CampoTextoLargo@MDTextField>:
    multiline: True
    size_hint_y: None
    height: dp(90)
    mode: "rectangle"

<MDRectangleFlatButton>:
    md_bg_color: app.color_azul
    text_color: 1, 1, 1, 1
    line_color: app.color_azul
    size_hint_x: 1

<MDFlatButton>:
    text_color: app.color_azul
    size_hint_x: 1

<ItemNav@BoxLayout>:
    nombre_pantalla: ""
    icono: ""
    etiqueta: ""
    orientation: "vertical"
    padding: 0, dp(4)

    MDIconButton:
        icon: root.icono
        pos_hint: {"center_x": 0.5}
        theme_text_color: "Custom"
        text_color: app.color_azul if app.root and app.root.current == root.nombre_pantalla else app.color_texto_secundario
        on_release: app.root.current = root.nombre_pantalla

    MDLabel:
        text: root.etiqueta
        font_style: "Caption"
        halign: "center"
        size_hint_y: None
        height: dp(16)
        theme_text_color: "Custom"
        text_color: app.color_azul if app.root and app.root.current == root.nombre_pantalla else app.color_texto_secundario

<BarraNavegacion@BoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(64)
    canvas.before:
        Color:
            rgba: app.color_superficie
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.color_borde
        Line:
            points: [self.x, self.top, self.x + self.width, self.top]
            width: 1

    ItemNav:
        nombre_pantalla: "inicio"
        icono: "home-variant"
        etiqueta: "Inicio"

    ItemNav:
        nombre_pantalla: "historial"
        icono: "history"
        etiqueta: "Historial"

    ItemNav:
        nombre_pantalla: "configuracion"
        icono: "cog-outline"
        etiqueta: "Perfil"

<BarraSuperior@MDTopAppBar>:
    accion_volver: None
    title: ""
    elevation: 0
    md_bg_color: app.color_azul
    left_action_items: [["arrow-left", lambda x: root.accion_volver()]] if root.accion_volver else []

<TarjetaSeccion@MDCard>:
    orientation: "vertical"
    padding: dp(16)
    spacing: dp(10)
    size_hint_y: None
    height: self.minimum_height
    radius: [dp(12)]
    elevation: 1
    md_bg_color: app.color_superficie


<PantallaEntrada>:
    ScrollView:
        BoxLayout:
            orientation: "vertical"
            padding: dp(24), dp(36)
            spacing: dp(14)
            size_hint_y: None
            height: max(self.minimum_height, root.height)

            Widget:
                size_hint_y: None
                height: dp(12)

            MDLabel:
                text: "PI"
                size_hint: None, None
                size: dp(56), dp(56)
                pos_hint: {"center_x": 0.5}
                halign: "center"
                valign: "middle"
                text_size: self.size
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                canvas.before:
                    Color:
                        rgba: app.color_azul
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(14)]

            MDLabel:
                text: "ProfeIA"
                bold: True
                font_style: "H4"
                halign: "center"
                text_size: self.width, None
                size_hint_y: None
                height: dp(52)
                theme_text_color: "Custom"
                text_color: app.color_texto

            MDLabel:
                text: "El copiloto de IA para docentes"
                halign: "center"
                text_size: self.width, None
                size_hint_y: None
                height: dp(24)
                theme_text_color: "Custom"
                text_color: app.color_texto_secundario

            Widget:
                size_hint_y: None
                height: dp(8)

            TarjetaSeccion:
                padding: dp(18)
                spacing: dp(12)

                MDLabel:
                    text: "Soy alumno"
                    bold: True
                    size_hint_y: None
                    height: dp(24)
                    theme_text_color: "Custom"
                    text_color: app.color_texto

                MDLabel:
                    text: "Ingresa el codigo que te dio tu docente"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(22)
                    theme_text_color: "Custom"
                    text_color: app.color_texto_secundario

                MDTextField:
                    id: campo_codigo
                    hint_text: "Codigo de clase"
                    mode: "rectangle"
                    halign: "center"
                    font_size: "22sp"
                    size_hint_y: None
                    height: dp(60)

                MDRectangleFlatButton:
                    text: "ENTRAR COMO ALUMNO"
                    size_hint_x: 1
                    height: dp(52)
                    on_release: root.al_presionar_entrar_alumno()

            MDLabel:
                id: etiqueta_error
                theme_text_color: "Error"
                halign: "center"
                text_size: self.width, None
                size_hint_y: None
                height: dp(26)

            Widget:
                size_hint_y: None
                height: dp(4)

            MDLabel:
                text: "Soy docente"
                halign: "center"
                text_size: self.width, None
                size_hint_y: None
                height: dp(22)
                theme_text_color: "Custom"
                text_color: app.color_texto_secundario

            MDRectangleFlatButton:
                text: "INGRESAR O CREAR CUENTA DOCENTE"
                size_hint_x: 1
                height: dp(52)
                on_release: root.al_presionar_soy_docente()

            Widget:


<PantallaLogin>:
    BoxLayout:
        orientation: "vertical"

        BarraSuperior:
            title: "Ingresar"
            accion_volver: root.al_presionar_volver

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                padding: dp(24), dp(24)
                spacing: dp(14)
                size_hint_y: None
                height: max(self.minimum_height, root.height - dp(56))

                Widget:
                    size_hint_y: 1

                MDLabel:
                    text: "Bienvenido de nuevo"
                    bold: True
                    font_style: "H5"
                    halign: "center"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(40)
                    theme_text_color: "Custom"
                    text_color: app.color_texto

                MDLabel:
                    text: "Ingresa con tu cuenta docente"
                    halign: "center"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(24)
                    theme_text_color: "Custom"
                    text_color: app.color_texto_secundario

                Widget:
                    size_hint_y: None
                    height: dp(8)

                MDTextField:
                    id: campo_email
                    hint_text: "Email"
                    mode: "rectangle"
                    size_hint_x: 1

                MDTextField:
                    id: campo_password
                    hint_text: "Clave"
                    mode: "rectangle"
                    password: True
                    size_hint_x: 1

                MDLabel:
                    id: etiqueta_error
                    theme_text_color: "Error"
                    halign: "center"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(26)

                MDRectangleFlatButton:
                    id: boton_ingresar
                    text: "INGRESAR"
                    size_hint_x: 1
                    height: dp(52)
                    on_release: root.al_presionar_ingresar()

                MDFlatButton:
                    text: "NO TENGO CUENTA, QUIERO CREARLA"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.al_presionar_ir_a_registro()

                Widget:
                    size_hint_y: 1


<PantallaRegistro>:
    BoxLayout:
        orientation: "vertical"

        BarraSuperior:
            title: "Crear cuenta"
            accion_volver: root.al_presionar_volver

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                padding: dp(24), dp(24)
                spacing: dp(14)
                size_hint_y: None
                height: max(self.minimum_height, root.height - dp(56))

                Widget:
                    size_hint_y: 1

                MDLabel:
                    text: "Crea tu cuenta docente"
                    bold: True
                    font_style: "H5"
                    halign: "center"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(40)
                    theme_text_color: "Custom"
                    text_color: app.color_texto

                MDLabel:
                    text: "Empeza a generar clases en minutos"
                    halign: "center"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(24)
                    theme_text_color: "Custom"
                    text_color: app.color_texto_secundario

                Widget:
                    size_hint_y: None
                    height: dp(8)

                MDTextField:
                    id: campo_nombre
                    hint_text: "Nombre"
                    mode: "rectangle"
                    size_hint_x: 1

                MDTextField:
                    id: campo_email
                    hint_text: "Email"
                    mode: "rectangle"
                    size_hint_x: 1

                MDTextField:
                    id: campo_password
                    hint_text: "Clave (minimo 6 caracteres)"
                    mode: "rectangle"
                    password: True
                    size_hint_x: 1

                MDLabel:
                    id: etiqueta_error
                    theme_text_color: "Error"
                    halign: "center"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(26)

                MDRectangleFlatButton:
                    id: boton_crear_cuenta
                    text: "CREAR CUENTA"
                    size_hint_x: 1
                    height: dp(52)
                    on_release: root.al_presionar_crear_cuenta()

                MDFlatButton:
                    text: "YA TENGO CUENTA, INGRESAR"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.al_presionar_volver()

                Widget:
                    size_hint_y: 1


<PantallaInicio>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(18)
        spacing: dp(12)

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)
            size_hint_y: None
            height: dp(52)

            MDLabel:
                text: "PI"
                size_hint: None, None
                size: dp(36), dp(36)
                halign: "center"
                valign: "middle"
                text_size: self.size
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                canvas.before:
                    Color:
                        rgba: app.color_azul
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(6)]

            MDLabel:
                text: "ProfeIA"
                bold: True
                font_style: "H6"
                theme_text_color: "Custom"
                text_color: app.color_texto

        EtiquetaSeccion:
            text: "Que queres ensenar hoy?"

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                spacing: dp(20)
                size_hint_y: None
                height: self.minimum_height

                TarjetaSeccion:
                    padding: dp(16), dp(18)
                    spacing: dp(14)

                    MDTextField:
                        id: campo_prompt
                        hint_text: "Describe tu clase"
                        helper_text: "Ej: clase de 8 min sobre fracciones para chicos de 10 anos"
                        helper_text_mode: "persistent"
                        multiline: True
                        size_hint_y: None
                        height: dp(110)
                        mode: "rectangle"
                        on_text: root.al_cambiar_prompt(self.text)

                    MDLabel:
                        text: "Plantillas rapidas"
                        bold: True
                        size_hint_y: None
                        height: dp(24)
                        theme_text_color: "Custom"
                        text_color: app.color_texto_secundario

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: dp(6)
                        size_hint_y: None
                        height: dp(48)

                        MDRectangleFlatButton:
                            text: "EXPLICAR"
                            on_release: root.al_presionar_plantilla("explicacion")

                        MDFlatButton:
                            text: "PRACTICAR"
                            on_release: root.al_presionar_plantilla("practica")

                        MDFlatButton:
                            text: "EVALUAR"
                            on_release: root.al_presionar_plantilla("evaluacion")

                TarjetaSeccion:
                    MDLabel:
                        text: "Sugerencias"
                        bold: True
                        size_hint_y: None
                        height: dp(24)
                        theme_text_color: "Custom"
                        text_color: app.color_texto

                    MDLabel:
                        id: etiqueta_sugerencias
                        size_hint_y: None
                        height: self.texture_size[1] + dp(8)
                        text_size: self.width, None
                        theme_text_color: "Custom"
                        text_color: app.color_texto_secundario

                    MDFlatButton:
                        text: "USAR SUGERENCIAS"
                        pos_hint: {"center_x": 0.5}
                        on_release: root.al_presionar_usar_sugerencias()

                TarjetaSeccion:
                    MDLabel:
                        text: "Duracion"
                        bold: True
                        size_hint_y: None
                        height: dp(24)
                        theme_text_color: "Custom"
                        text_color: app.color_texto_secundario

                    MDBoxLayout:
                        id: grupo_duracion
                        orientation: "horizontal"
                        spacing: dp(6)
                        size_hint_y: None
                        height: dp(48)
                        selected: chip_3min

                        MDChip:
                            id: chip_3min
                            text: "3 min"
                            on_release: grupo_duracion.selected = self
                            MDChipText:
                                text: "3 min"

                        MDChip:
                            id: chip_5min
                            text: "5 min"
                            on_release: grupo_duracion.selected = self
                            MDChipText:
                                text: "5 min"

                        MDChip:
                            id: chip_8min
                            text: "8 min"
                            on_release: grupo_duracion.selected = self
                            MDChipText:
                                text: "8 min"

                        MDChip:
                            id: chip_15min
                            text: "15 min"
                            on_release: grupo_duracion.selected = self
                            MDChipText:
                                text: "15 min"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(48)

                        MDTextField:
                            id: campo_edad
                            hint_text: "Edad o grado *"
                            text: ""
                            on_text: root.al_cambiar_prompt(self.text)

                        MDTextField:
                            id: campo_materia
                            hint_text: "Materia *"
                            text: ""
                            on_text: root.al_cambiar_prompt(self.text)

                MDLabel:
                    id: etiqueta_error
                    theme_text_color: "Error"
                    size_hint_y: None
                    height: dp(24)

                MDRectangleFlatButton:
                    id: boton_generar
                    text: "GENERAR CLASE"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.al_presionar_generar_clase()

                MDSpinner:
                    id: indicador_carga
                    size_hint: None, None
                    size: dp(36), dp(36)
                    pos_hint: {"center_x": 0.5}
                    active: False

        BarraNavegacion:


<PantallaPlan>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        EtiquetaSeccion:
            text: "Configuracion"

        MDLabel:
            id: etiqueta_estado
            size_hint_y: None
            height: dp(42)
            halign: "center"
            text_size: self.width, None
            theme_text_color: "Custom"
            text_color: app.color_texto

        MDSpinner:
            id: indicador_carga
            size_hint: None, None
            size: dp(36), dp(36)
            pos_hint: {"center_x": 0.5}
            active: False

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height

                TarjetaSeccion:
                    padding: dp(16), dp(16)
                    spacing: dp(8)

                    MDLabel:
                        text: "Perfil docente"
                        bold: True
                        size_hint_y: None
                        height: dp(24)
                        theme_text_color: "Custom"
                        text_color: app.color_texto

                    MDLabel:
                        id: etiqueta_perfil_nombre
                        size_hint_y: None
                        height: dp(22)
                        text_size: self.width, None
                        theme_text_color: "Secondary"

                    MDLabel:
                        id: etiqueta_perfil_email
                        size_hint_y: None
                        height: dp(22)
                        text_size: self.width, None
                        theme_text_color: "Secondary"

                    MDLabel:
                        id: etiqueta_perfil_materia
                        size_hint_y: None
                        height: dp(22)
                        text_size: self.width, None
                        theme_text_color: "Secondary"

                    MDLabel:
                        id: etiqueta_perfil_miembro_desde
                        size_hint_y: None
                        height: dp(22)
                        text_size: self.width, None
                        theme_text_color: "Secondary"

                EtiquetaSeccion:
                    text: "Uso mensual"
                    font_style: "Subtitle1"

                MDLabel:
                    id: etiqueta_uso
                    size_hint_y: None
                    height: self.texture_size[1] + dp(12)
                    text_size: self.width, None

                EtiquetaSeccion:
                    text: "Planes disponibles"
                    font_style: "Subtitle1"

                MDLabel:
                    id: etiqueta_planes
                    size_hint_y: None
                    height: self.texture_size[1] + dp(12)
                    text_size: self.width, None
                    theme_text_color: "Secondary"

                EtiquetaSeccion:
                    text: "Suscripcion"
                    font_style: "Subtitle1"

                BoxLayout:
                    orientation: "horizontal"
                    spacing: dp(8)
                    size_hint_y: None
                    height: dp(48)

                    MDRectangleFlatButton:
                        id: boton_plan_docente
                        text: "ACTIVAR DOCENTE"
                        on_release: root.al_presionar_suscribirse("docente")

                    MDFlatButton:
                        id: boton_plan_pro
                        text: "ACTIVAR PRO"
                        on_release: root.al_presionar_suscribirse("pro")

                MDLabel:
                    id: etiqueta_estado_pago
                    size_hint_y: None
                    height: dp(38)
                    halign: "center"
                    text_size: self.width, None
                    theme_text_color: "Secondary"

                EtiquetaSeccion:
                    text: "Cuenta"
                    font_style: "Subtitle1"

                MDLabel:
                    text: "Eliminar la cuenta borra el perfil docente y sus clases asociadas."
                    size_hint_y: None
                    height: dp(44)
                    text_size: self.width, None
                    theme_text_color: "Secondary"

                MDFlatButton:
                    text: "CERRAR SESION"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.al_presionar_cerrar_sesion()

                MDFlatButton:
                    text: "BORRAR CUENTA"
                    pos_hint: {"center_x": 0.5}
                    theme_text_color: "Error"
                    on_release: root.al_presionar_borrar_cuenta()

        MDFlatButton:
            text: "VOLVER"
            pos_hint: {"center_x": 0.5}
            on_release: root.al_presionar_volver()

        BarraNavegacion:


<PantallaHistorial>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        EtiquetaSeccion:
            text: "Historial de clases"

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(8)
            size_hint_y: None
            height: dp(50)

            MDTextField:
                id: campo_busqueda
                hint_text: "Buscar por tema, materia o codigo"
                mode: "rectangle"
                on_text: root.al_cambiar_busqueda(self.text)

            MDFlatButton:
                text: "LIMPIAR"
                on_release: root.al_presionar_limpiar_busqueda()

        MDLabel:
            id: etiqueta_estado
            size_hint_y: None
            height: dp(34)
            halign: "center"
            text_size: self.width, None
            theme_text_color: "Secondary"

        MDSpinner:
            id: indicador_carga
            size_hint: None, None
            size: dp(36), dp(36)
            pos_hint: {"center_x": 0.5}
            active: False

        ScrollView:
            BoxLayout:
                id: contenedor_clases
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

        MDFlatButton:
            text: "VOLVER"
            pos_hint: {"center_x": 0.5}
            on_release: root.al_presionar_volver()

        BarraNavegacion:


<PantallaContenido>:
    BoxLayout:
        orientation: "vertical"

        BarraSuperior:
            title: "Tu clase generada"
            accion_volver: root.al_presionar_atras

        BoxLayout:
            orientation: "vertical"
            padding: dp(16)
            spacing: dp(10)

            ScrollView:
                BoxLayout:
                    orientation: "vertical"
                    spacing: dp(20)
                    size_hint_y: None
                    height: self.minimum_height

                    TarjetaSeccion:
                        MDLabel:
                            text: "Titulo y objetivo"
                            bold: True
                            size_hint_y: None
                            height: dp(24)
                            theme_text_color: "Custom"
                            text_color: app.color_texto_secundario

                        MDTextField:
                            id: campo_titulo
                            hint_text: "Titulo"

                        CampoTextoLargo:
                            id: campo_objetivo
                            hint_text: "Objetivo"

                    TarjetaSeccion:
                        MDLabel:
                            text: "Desarrollo"
                            bold: True
                            size_hint_y: None
                            height: dp(24)
                            theme_text_color: "Custom"
                            text_color: app.color_texto_secundario

                        CampoTextoLargo:
                            id: campo_introduccion
                            hint_text: "Introduccion"

                        CampoTextoLargo:
                            id: campo_explicacion
                            hint_text: "Explicacion"

                        CampoTextoLargo:
                            id: campo_ejemplos
                            hint_text: "Ejemplos (uno por linea)"

                        CampoTextoLargo:
                            id: campo_actividad
                            hint_text: "Actividad"

                    TarjetaSeccion:
                        MDLabel:
                            text: "Cierre"
                            bold: True
                            size_hint_y: None
                            height: dp(24)
                            theme_text_color: "Custom"
                            text_color: app.color_texto_secundario

                        CampoTextoLargo:
                            id: campo_preguntas
                            hint_text: "Preguntas (una por linea)"

                        CampoTextoLargo:
                            id: campo_cuestionario
                            hint_text: "Cuestionario (una consigna por linea)"

                        CampoTextoLargo:
                            id: campo_tarea_hogar
                            hint_text: "Tarea para el hogar"

                        CampoTextoLargo:
                            id: campo_resumen
                            hint_text: "Resumen / cierre"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: dp(10)
                        size_hint_y: None
                        height: dp(48)

                        MDFlatButton:
                            id: boton_cancelar
                            text: "CANCELAR"
                            opacity: 0
                            disabled: True
                            on_release: root.al_presionar_cancelar()

                        MDRectangleFlatButton:
                            id: boton_continuar
                            text: "CONTINUAR"
                            on_release: root.al_presionar_continuar()


<PantallaAdaptar>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        BarraSuperior:
            title: "Adaptar la clase"
            accion_volver: root.al_presionar_atras

        MDLabel:
            text: "Opcional: genera apoyos para estudiantes que necesitan mas estructura, pausas o consignas simples."
            size_hint_y: None
            height: dp(58)
            text_size: self.width, None
            theme_text_color: "Secondary"

        TarjetaSeccion:

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                MDCheckbox:
                    id: check_tdah
                    active: True
                    size_hint_x: None
                    width: dp(48)
                MDLabel:
                    text: "Atencion / TDAH"

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                MDCheckbox:
                    id: check_tea
                    active: False
                    size_hint_x: None
                    width: dp(48)
                MDLabel:
                    text: "TEA / autismo"

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                MDCheckbox:
                    id: check_lectura
                    active: True
                    size_hint_x: None
                    width: dp(48)
                MDLabel:
                    text: "Lectura facil"

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                MDCheckbox:
                    id: check_ansiedad
                    active: False
                    size_hint_x: None
                    width: dp(48)
                MDLabel:
                    text: "Ansiedad / participacion gradual"

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                MDCheckbox:
                    id: check_rutina
                    active: True
                    size_hint_x: None
                    width: dp(48)
                MDLabel:
                    text: "Rutina visual"

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                MDCheckbox:
                    id: check_pausas
                    active: True
                    size_hint_x: None
                    width: dp(48)
                MDLabel:
                    text: "Pausas breves"

        MDLabel:
            id: etiqueta_estado
            size_hint_y: None
            height: dp(34)
            halign: "center"
            text_size: self.width, None
            theme_text_color: "Secondary"

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)
            size_hint_y: None
            height: dp(48)

            MDFlatButton:
                id: boton_saltar
                text: "SALTAR"
                on_release: root.al_presionar_saltar()

            MDRectangleFlatButton:
                id: boton_generar
                text: "GENERAR APOYOS"
                on_release: root.al_presionar_generar_apoyos()

        MDSpinner:
            id: indicador_carga
            size_hint: None, None
            size: dp(36), dp(36)
            pos_hint: {"center_x": 0.5}
            active: False


